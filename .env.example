# Gemini API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public application URL
APP_URL="MY_APP_URL"

# In-memory traffic records limit before FIFO rotation
MAX_IN_MEMORY_RECORDS="5000"

# Path to JSON-Lines traffic storage file
TRAFFIC_LOG_PATH="./traffic.jsonl"

# Dashboard authentication credentials
ADMIN_USER="admin"
ADMIN_PASS="admin123"

# Webhook URL for threat alerts
ALERT_WEBHOOK_URL=""

# Path to ML features storage file
FEATURES_LOG_PATH="./features.jsonl"

# Hash client IPs in exported ML features
HASH_IPS="false"
IP_HASH_SALT=""
